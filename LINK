<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Athena Hub</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    min-height:100vh;
    background:#03060b;
    color:#fff;
    font-family:Arial,Helvetica,sans-serif;
    overflow-x:hidden;
}

/* BACKGROUND */

.background{
    position:fixed;
    inset:0;
    z-index:-3;
    background:
        radial-gradient(
            circle at 50% -10%,
            rgba(0,130,255,.25),
            transparent 38%
        ),
        radial-gradient(
            circle at 0% 100%,
            rgba(0,70,255,.10),
            transparent 30%
        ),
        #03060b;
}

.grid{
    position:fixed;
    inset:0;
    z-index:-2;
    opacity:.18;
    background-image:
        linear-gradient(rgba(70,150,255,.08) 1px,transparent 1px),
        linear-gradient(90deg,rgba(70,150,255,.08) 1px,transparent 1px);
    background-size:50px 50px;
    mask-image:linear-gradient(
        to bottom,
        black,
        transparent 85%
    );
}

/* PARTICLES */

#particles{
    position:fixed;
    inset:0;
    z-index:-1;
    overflow:hidden;
    pointer-events:none;
}

.particle{
    position:absolute;
    width:3px;
    height:3px;
    border-radius:50%;
    background:#48baff;
    box-shadow:
        0 0 8px #168cff,
        0 0 18px #168cff;
    animation:particleMove linear infinite;
}

@keyframes particleMove{
    from{
        transform:translateY(110vh);
        opacity:0;
    }

    15%{
        opacity:.8;
    }

    85%{
        opacity:.8;
    }

    to{
        transform:translateY(-10vh);
        opacity:0;
    }
}

/* HEADER */

header{
    position:relative;
    text-align:center;
    padding:100px 20px 85px;
    border-bottom:1px solid rgba(100,170,255,.12);
    overflow:hidden;
}

.header-glow{
    position:absolute;
    width:700px;
    height:450px;
    left:50%;
    top:-330px;
    transform:translateX(-50%);
    background:radial-gradient(
        circle,
        rgba(0,130,255,.42),
        transparent 68%
    );
    filter:blur(25px);
    animation:glowPulse 5s ease-in-out infinite;
}

@keyframes glowPulse{
    0%,100%{
        opacity:.55;
        transform:translateX(-50%) scale(1);
    }

    50%{
        opacity:1;
        transform:translateX(-50%) scale(1.15);
    }
}

.badge{
    position:relative;
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:10px 18px;
    border:1px solid rgba(70,170,255,.35);
    border-radius:50px;
    color:#7dd3fc;
    font-size:11px;
    font-weight:bold;
    letter-spacing:3px;
    text-transform:uppercase;
    animation:fadeDown .8s ease both;
}

.badge-dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:#39aaff;
    box-shadow:
        0 0 8px #39aaff,
        0 0 18px #39aaff;
    animation:blink 2s infinite;
}

@keyframes blink{
    0%,100%{
        opacity:1;
    }

    50%{
        opacity:.3;
    }
}

.logo{
    position:relative;
    margin-top:22px;
    font-size:clamp(48px,10vw,92px);
    font-weight:900;
    letter-spacing:4px;
    background:
        linear-gradient(
            90deg,
            #ffffff,
            #8bddff,
            #258cff,
            #ffffff
        );
    background-size:300%;
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
    animation:
        fadeUp .9s ease both,
        shine 5s linear infinite;
}

@keyframes shine{
    to{
        background-position:-300%;
    }
}

.subtitle{
    position:relative;
    max-width:520px;
    margin:18px auto 0;
    color:#8794a7;
    font-size:15px;
    line-height:1.7;
    animation:fadeUp 1s .15s ease both;
}

@keyframes fadeUp{
    from{
        opacity:0;
        transform:translateY(25px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes fadeDown{
    from{
        opacity:0;
        transform:translateY(-20px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* MAIN */

main{
    position:relative;
    width:min(920px,calc(100% - 30px));
    margin:auto;
    padding:75px 0 110px;
}

.section-title{
    display:flex;
    align-items:center;
    gap:16px;
    margin-bottom:30px;
    color:#7f8b9d;
    font-size:11px;
    font-weight:bold;
    letter-spacing:3px;
}

.section-title::after{
    content:"";
    height:1px;
    flex:1;
    background:
        linear-gradient(
            90deg,
            rgba(100,170,255,.3),
            transparent
        );
}

/* PRODUCTS */

.products{
    display:flex;
    flex-direction:column;
    gap:26px;
}

/* CARD */

.product{
    position:relative;
    min-height:340px;
    padding:42px;
    border:1px solid rgba(100,170,255,.16);
    border-radius:25px;
    overflow:hidden;

    background:
        linear-gradient(
            145deg,
            rgba(18,29,46,.96),
            rgba(5,9,16,.99)
        );

    box-shadow:
        0 20px 70px rgba(0,0,0,.45);

    animation:cardAppear .8s ease both;

    transition:
        transform .35s ease,
        border-color .35s ease,
        box-shadow .35s ease;
}

.product:nth-child(1){
    animation-delay:.1s;
}

.product:nth-child(2){
    animation-delay:.25s;
}

.product:nth-child(3){
    animation-delay:.4s;
}

@keyframes cardAppear{
    from{
        opacity:0;
        transform:translateY(40px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

.product:hover{
    transform:translateY(-8px);
    border-color:rgba(45,150,255,.55);
    box-shadow:
        0 30px 90px rgba(0,0,0,.65),
        0 0 45px rgba(20,130,255,.12);
}

.product::before{
    content:"";
    position:absolute;
    width:500px;
    height:500px;
    right:-280px;
    top:-330px;
    background:
        radial-gradient(
            circle,
            rgba(30,140,255,.27),
            transparent 70%
        );
    pointer-events:none;
}

.product::after{
    content:"";
    position:absolute;
    left:0;
    right:0;
    top:0;
    height:1px;
    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(80,190,255,.7),
            transparent
        );
}

/* NUMBER */

.number{
    position:absolute;
    top:25px;
    right:30px;
    color:rgba(100,190,255,.25);
    font-size:13px;
    font-weight:bold;
    letter-spacing:2px;
}

/* ICON */

.icon{
    position:relative;
    width:65px;
    height:65px;
    margin-bottom:25px;
    border:1px solid rgba(70,175,255,.4);
    border-radius:16px;
    background:rgba(20,130,255,.06);
    display:flex;
    align-items:center;
    justify-content:center;
    box-shadow:
        inset 0 0 25px rgba(30,140,255,.08),
        0 0 30px rgba(30,140,255,.08);
}

.icon::before{
    content:"";
    width:24px;
    height:24px;
    border:2px solid #54bfff;
    transform:rotate(45deg);
    box-shadow:
        0 0 18px rgba(50,180,255,.8);
    animation:iconFloat 3s ease-in-out infinite;
}

@keyframes iconFloat{
    0%,100%{
        transform:rotate(45deg) translateY(0);
    }

    50%{
        transform:rotate(45deg) translateY(-5px);
    }
}

/* TEXT */

.product h2{
    position:relative;
    font-size:29px;
    margin-bottom:10px;
}

.description{
    position:relative;
    max-width:620px;
    margin-bottom:30px;
    color:#8996a9;
    font-size:14px;
    line-height:1.7;
}

/* BOTTOM */

.bottom{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:25px;
}

.price{
    font-size:39px;
    font-weight:900;
    white-space:nowrap;
}

.price span{
    color:#8996a9;
    font-size:13px;
    font-weight:normal;
}

/* BUTTONS */

.buttons{
    display:flex;
    gap:12px;
}

.button{
    border:0;
    border-radius:11px;
    padding:16px 25px;
    min-width:190px;
    font-size:13px;
    font-weight:bold;
    text-decoration:none;
    cursor:pointer;
    transition:.25s ease;
}

.paypal{
    background:#ffc439;
    color:#003087;
    box-shadow:
        0 8px 30px rgba(255,196,57,.14);
}

.paypal:hover{
    transform:translateY(-3px);
    box-shadow:
        0 12px 40px rgba(255,196,57,.35);
}

.transfer{
    background:#1769e8;
    color:#fff;
    box-shadow:
        0 8px 30px rgba(23,105,232,.18);
}

.transfer:hover{
    transform:translateY(-3px);
    box-shadow:
        0 12px 40px rgba(23,105,232,.4);
}

/* BANK */

.bank{
    max-height:0;
    opacity:0;
    overflow:hidden;
    margin-top:0;
    padding:0 20px;
    border:1px solid transparent;
    border-radius:14px;
    background:rgba(20,130,255,.04);
    transition:.45s ease;
}

.bank.open{
    max-height:230px;
    opacity:1;
    margin-top:25px;
    padding:20px;
    border-color:rgba(50,160,255,.22);
}

.bank-title{
    color:#70d0ff;
    font-size:11px;
    font-weight:bold;
    letter-spacing:2px;
    margin-bottom:10px;
}

.bank-row{
    display:flex;
    justify-content:space-between;
    gap:20px;
    padding:10px 0;
    border-bottom:1px dashed rgba(255,255,255,.08);
    color:#c6d0dc;
    font-size:13px;
}

.bank-row:last-child{
    border-bottom:0;
}

/* FOOTER */

footer{
    position:relative;
    border-top:1px solid rgba(100,170,255,.12);
    padding:35px 20px;
    text-align:center;
    color:#667286;
    font-size:11px;
    letter-spacing:2px;
}

/* MOBILE */

@media(max-width:700px){

    header{
        padding:75px 18px 65px;
    }

    main{
        width:calc(100% - 24px);
        padding:55px 0 80px;
    }

    .product{
        padding:30px 23px;
        min-height:0;
    }

    .bottom{
        flex-direction:column;
        align-items:stretch;
    }

    .buttons{
        flex-direction:column;
    }

    .button{
        width:100%;
        min-width:0;
        text-align:center;
    }

    .bank-row{
        flex-direction:column;
        gap:4px;
    }

    .price{
        font-size:34px;
    }
}
</style>
</head>

