<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Athena Hub</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  min-height:100vh;
  background:#04070c;
  color:#fff;
  font-family:Arial, sans-serif;
  overflow-x:hidden;
}

/* FOND */

body:before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(circle at 50% 0%,rgba(30,130,255,.22),transparent 35%),
    radial-gradient(circle at 0% 100%,rgba(20,70,255,.08),transparent 30%);
}

/* PARTICULES */

#particles{
  position:fixed;
  inset:0;
  overflow:hidden;
  pointer-events:none;
  z-index:0;
}

.particle{
  position:absolute;
  width:3px;
  height:3px;
  background:#55bfff;
  border-radius:50%;
  box-shadow:0 0 12px #168cff;
  animation:float linear infinite;
}

@keyframes float{
  from{
    transform:translateY(105vh);
    opacity:0;
  }
  15%{
    opacity:.7;
  }
  80%{
    opacity:.7;
  }
  to{
    transform:translateY(-10vh);
    opacity:0;
  }
}

/* HEADER */

header{
  position:relative;
  z-index:1;
  text-align:center;
  padding:100px 20px 80px;
  border-bottom:1px solid rgba(100,170,255,.12);
}

.badge{
  display:inline-block;
  padding:9px 17px;
  border:1px solid rgba(80,170,255,.35);
  border-radius:50px;
  color:#7dd3fc;
  font-size:11px;
  font-weight:bold;
  letter-spacing:3px;
  text-transform:uppercase;
  animation:appear .8s ease;
}

.badge:before{
  content:"";
  display:inline-block;
  width:7px;
  height:7px;
  margin-right:8px;
  background:#38aaff;
  border-radius:50%;
  box-shadow:0 0 12px #38aaff;
}

h1{
  margin-top:22px;
  font-size:clamp(48px,10vw,90px);
  font-weight:900;
  letter-spacing:3px;
  background:linear-gradient(
    90deg,
    #fff,
    #7dd3fc,
    #258cff,
    #fff
  );
  background-size:300%;
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  animation:
    appear 1s ease,
    shine 5s linear infinite;
}

@keyframes shine{
  to{
    background-position:-300%;
  }
}

.subtitle{
  margin:18px auto 0;
  max-width:500px;
  color:#8b97a9;
  font-size:15px;
  line-height:1.6;
  animation:appear 1.2s ease;
}

@keyframes appear{
  from{
    opacity:0;
    transform:translateY(25px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

/* CONTENU */

.container{
  position:relative;
  z-index:1;
  width:min(900px,calc(100% - 30px));
  margin:auto;
  padding:70px 0 100px;
}

.section-title{
  display:flex;
  align-items:center;
  gap:15px;
  margin-bottom:30px;
  color:#8995a7;
  font-size:11px;
  font-weight:bold;
  letter-spacing:3px;
  text-transform:uppercase;
}

.section-title:after{
  content:"";
  flex:1;
  height:1px;
  background:rgba(100,170,255,.15);
}

/* 3 GROSSES CARTES */

.products{
  display:flex;
  flex-direction:column;
  gap:25px;
}

.product{
  position:relative;
  min-height:330px;
  padding:42px;
  border:1px solid rgba(100,170,255,.14);
  border-radius:24px;
  background:
    linear-gradient(
      145deg,
      rgba(20,31,48,.96),
      rgba(5,9,16,.98)
    );
  overflow:hidden;
  box-shadow:0 20px 70px rgba(0,0,0,.35);
  transition:.35s ease;
  animation:card .8s ease both;
}

.product:nth-child(1){
  animation-delay:.1s;
}

.product:nth-child(2){
  animation-delay:.25s;
}

.product:nth-child(3){
  animation-delay:.4s;
}

@keyframes card{
  from{
    opacity:0;
    transform:translateY(35px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

.product:before{
  content:"";
  position:absolute;
  width:400px;
  height:400px;
  right:-220px;
  top:-250px;
  background:radial-gradient(
    circle,
    rgba(30,140,255,.25),
    transparent 70%
  );
}

.product:hover{
  transform:translateY(-8px);
  border-color:rgba(50,150,255,.5);
  box-shadow:
    0 30px 90px rgba(0,0,0,.55),
    0 0 45px rgba(30,130,255,.12);
}

/* NUMERO */

.number{
  position:absolute;
  top:25px;
  right:30px;
  color:rgba(100,190,255,.25);
  font-size:13px;
  font-weight:bold;
  letter-spacing:2px;
}

/* ICONE */

.icon{
  position:relative;
  width:65px;
  height:65px;
  margin-bottom:25px;
  border:1px solid rgba(70,170,255,.4);
  border-radius:16px;
  background:rgba(30,130,255,.06);
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0 0 30px rgba(30,130,255,.08);
}

.icon:after{
  content:"";
  width:25px;
  height:25px;
  border:2px solid #4bb9ff;
  transform:rotate(45deg);
  box-shadow:0 0 18px rgba(50,180,255,.7);
  animation:icon 3s ease-in-out infinite;
}

@keyframes icon{
  0%,100%{
    transform:rotate(45deg) translateY(0);
  }
  50%{
    transform:rotate(45deg) translateY(-5px);
  }
}

/* TEXTE */

.product h2{
  position:relative;
  font-size:28px;
  margin-bottom:10px;
}

.description{
  position:relative;
  max-width:600px;
  color:#8b97a9;
  font-size:14px;
  line-height:1.7;
  margin-bottom:28px;
}

.bottom{
  position:relative;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:25px;
}

.price{
  font-size:38px;
  font-weight:800;
}

.price span{
  color:#8793a5;
  font-size:13px;
  font-weight:normal;
}

/* BOUTONS */

.buttons{
  display:flex;
  gap:12px;
}

.button{
  border:0;
  border-radius:11px;
  padding:16px 25px;
  font-size:13px;
  font-weight:bold;
  cursor:pointer;
  text-decoration:none;
  transition:.25s ease;
}

.paypal{
  background:#ffc439;
  color:#003087;
  box-shadow:0 8px 30px rgba(255,196,57,.15);
}

.paypal:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 40px rgba(255,196,57,.35);
}

.transfer{
  background:#1769e8;
  color:white;
  box-shadow:0 8px 30px rgba(23,105,232,.2);
}

.transfer:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 40px rgba(23,105,232,.4);
}

/* VIREMENT */

.bank{
  max-height:0;
  opacity:0;
  overflow:hidden;
  margin-top:0;
  padding:0 20px;
  border:1px solid transparent;
  border-radius:13px;
  background:rgba(30,130,255,.04);
  transition:.45s ease;
}

.bank.open{
  max-height:250px;
  opacity:1;
  margin-top:25px;
  padding:20px;
  border-color:rgba(60,160,255,.2);
}

.bank-title{
  color:#70d0ff;
  font-size:11px;
  font-weight:bold;
  letter-spacing:2px;
  margin-bottom:12px;
}

.bank-row{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding:10px 0;
  border-bottom:1px dashed rgba(255,255,255,.08);
  color:#c5cfdb;
  font-size:13px;
}

.bank-row:last-child{
  border-bottom:0;
}

/* FOOTER */

footer{
  position:relative;
  z-index:1;
  padding:35px 20px;
  border-top:1px solid rgba(100,170,255,.12);
  text-align:center;
  color:#667286;
  font-size:11px;
  letter-spacing:2px;
}

/* MOBILE */

@media(max-width:650px){

  header{
    padding:75px 18px 65px;
  }

  .container{
    width:calc(100% - 24px);
    padding:55px 0 80px;
  }

  .product{
    padding:30px 23px;
  }

  .bottom{
    flex-direction:column;
    align-items:stretch;
  }

  .buttons{
    flex-direction:column;
  }

  .button{
    width:100%;
    text-align:center;
  }

  .bank-row{
    flex-direction:column;
    gap:4px;
  }

  .price{
    font-size:34px;
  }
}
</style>
</head>

