<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Athena Hub</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  min-height:100vh;
  background:#05070b;
  color:white;
  font-family:Arial, sans-serif;
  overflow-x:hidden;
}

/* PARTICULES */

.particles{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:0;
}

.particle{
  position:absolute;
  width:3px;
  height:3px;
  background:#39aaff;
  border-radius:50%;
  box-shadow:0 0 12px #168cff;
  animation:float linear infinite;
}

@keyframes float{
  from{
    transform:translateY(110vh);
    opacity:0;
  }

  15%{
    opacity:.8;
  }

  85%{
    opacity:.8;
  }

  to{
    transform:translateY(-10vh);
    opacity:0;
  }
}

/* HEADER */

header{
  position:relative;
  z-index:1;
  text-align:center;
  padding:90px 20px 75px;
  border-bottom:1px solid rgba(70,160,255,.15);
  overflow:hidden;
}

.glow{
  position:absolute;
  width:700px;
  height:450px;
  left:50%;
  top:-300px;
  transform:translateX(-50%);
  background:radial-gradient(
    circle,
    rgba(0,130,255,.35),
    transparent 70%
  );
  filter:blur(15px);
  animation:pulse 5s ease-in-out infinite;
}

@keyframes pulse{
  0%,100%{
    opacity:.6;
    transform:translateX(-50%) scale(1);
  }

  50%{
    opacity:1;
    transform:translateX(-50%) scale(1.15);
  }
}

.eyebrow{
  position:relative;
  display:inline-block;
  padding:10px 20px;
  border:1px solid rgba(50,150,255,.45);
  border-radius:30px;
  color:#7dd3fc;
  font-size:12px;
  letter-spacing:3px;
  margin-bottom:25px;
  animation:fadeDown .8s ease;
}

.eyebrow::before{
  content:"";
  display:inline-block;
  width:6px;
  height:6px;
  margin-right:9px;
  background:#42b8ff;
  border-radius:50%;
  box-shadow:0 0 12px #42b8ff;
}

.brand{
  position:relative;
  font-size:clamp(48px,9vw,82px);
  font-weight:900;
  letter-spacing:3px;
  background:linear-gradient(
    90deg,
    white,
    #8bddff,
    #258cff,
    white
  );
  background-size:300%;
  -webkit-background-clip:text;
  color:transparent;
  animation:
    fadeUp .8s ease,
    shine 5s linear infinite;
}

@keyframes shine{
  to{
    background-position:-300%;
  }
}

@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(30px);
  }

  to{
    opacity:1;
    transform:translateY(0);
  }
}

@keyframes fadeDown{
  from{
    opacity:0;
    transform:translateY(-20px);
  }

  to{
    opacity:1;
    transform:translateY(0);
  }
}

/* PRODUITS */

.container{
  position:relative;
  z-index:1;
  max-width:1200px;
  margin:auto;
  padding:75px 25px 100px;
}

.section-title{
  display:flex;
  align-items:center;
  gap:20px;
  margin-bottom:45px;
  color:white;
  font-size:14px;
  font-weight:bold;
  letter-spacing:4px;
}

.section-title::before,
.section-title::after{
  content:"";
  height:1px;
  flex:1;
  background:linear-gradient(
    90deg,
    transparent,
    rgba(50,150,255,.5)
  );
}

/* GRID */

.products{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

/* CARTE */

.product{
  position:relative;
  padding:35px 25px;
  min-height:430px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;

  background:
    linear-gradient(
      145deg,
      rgba(20,30,45,.75),
      rgba(5,10,18,.9)
    );

  border:1px solid rgba(100,170,255,.2);
  border-radius:18px;

  overflow:hidden;

  opacity:0;
  animation:cardAppear .8s ease forwards;

  transition:
    transform .35s ease,
    border-color .35s ease,
    box-shadow .35s ease;
}

.product:nth-child(1){
  animation-delay:.15s;
}

.product:nth-child(2){
  animation-delay:.3s;
}

.product:nth-child(3){
  animation-delay:.45s;
}

@keyframes cardAppear{
  from{
    opacity:0;
    transform:translateY(40px) scale(.95);
  }

  to{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}

.product:hover{
  transform:translateY(-10px);
  border-color:#168cff;
  box-shadow:
    0 20px 60px rgba(0,100,255,.18),
    0 0 30px rgba(0,140,255,.1);
}

.product::before{
  content:"";
  position:absolute;
  width:220px;
  height:220px;
  top:-130px;
  right:-100px;
  background:radial-gradient(
    circle,
    rgba(0,140,255,.3),
    transparent 70%
  );
}

/* CUBE */

.cube{
  width:115px;
  height:115px;
  position:relative;
  margin-bottom:35px;
  transform:rotate(30deg) skewY(-8deg);
  border:2px solid #42b8ff;
  box-shadow:
    0 0 15px rgba(40,170,255,.7),
    inset 0 0 25px rgba(30,150,255,.1);
  animation:cubeFloat 3s ease-in-out infinite;
}

.cube::before{
  content:"";
  position:absolute;
  width:78px;
  height:78px;
  left:-2px;
  top:-2px;
  border-top:2px solid #8bddff;
  border-left:2px solid #8bddff;
  transform:translate(-25px,-25px);
}

.cube::after{
  content:"";
  position:absolute;
  width:78px;
  height:78px;
  right:-2px;
  bottom:-2px;
  border-right:2px solid #168cff;
  border-bottom:2px solid #168cff;
  transform:translate(25px,25px);
}

@keyframes cubeFloat{
  0%,100%{
    transform:rotate(30deg) skewY(-8deg) translateY(0);
  }

  50%{
    transform:rotate(30deg) skewY(-8deg) translateY(-8px);
  }
}

/* PRIX */

.price{
  font-size:38px;
  font-weight:800;
  margin-bottom:25px;
}

.price span{
  color:#36aaff;
  font-size:15px;
  margin-left:5px;
}

/* BOUTONS */

.paypal{
  width:100%;
  max-width:260px;
  padding:15px;
  border:0;
  border-radius:9px;
  background:#ffc439;
  color:#003087;
  font-weight:800;
  font-size:15px;
  text-decoration:none;
  cursor:pointer;

  box-shadow:0 8px 25px rgba(255,196,57,.15);

  transition:.25s;
}

.paypal:hover{
  transform:scale(1.04);
  box-shadow:0 10px 35px rgba(255,196,57,.4);
}

/* VIREMENT */

.transfer{
  width:100%;
  max-width:260px;
  margin-top:12px;
  padding:15px;
  border:0;
  border-radius:9px;
  background:#1265df;
  color:white;
  font-weight:800;
  font-size:15px;
  cursor:pointer;
  transition:.25s;
}

.transfer:hover{
  transform:scale(1.04);
  box-shadow:0 10px 35px rgba(20,120,255,.4);
}

.bank{
  display:none;
  width:100%;
  max-width:260px;
  margin-top:15px;
  padding:15px;
  background:rgba(20,100,200,.08);
  border:1px solid rgba(50,150,255,.25);
  border-radius:10px;
  font-size:12px;
  color:#b9c4d4;
}

.bank.open{
  display:block;
  animation:fadeUp .3s ease;
}

.bank strong{
  display:block;
  color:#55baff;
  margin-bottom:8px;
}

/* FOOTER */

footer{
  position:relative;
  z-index:1;
  padding:35px 20px;
  text-align:center;
  border-top:1px solid rgba(70,160,255,.12);
  color:#687384;
  font-size:12px;
  letter-spacing:2px;
}

/* MOBILE */

@media(max-width:800px){

  .products{
    grid-template-columns:1fr;
    max-width:430px;
    margin:auto;
  }

  .product{
    min-height:400px;
  }

  .container{
    padding-top:55px;
  }

  header{
    padding-top:70px;
  }
}
</style>
</head>

