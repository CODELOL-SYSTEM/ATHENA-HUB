<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Athena Hub</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#03050a;
  --card:#0b1019;
  --blue:#248cff;
  --cyan:#75d7ff;
  --text:#f7faff;
  --muted:#8c98aa;
  --border:rgba(100,170,255,.15);
  --glow:rgba(36,140,255,.3);
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  min-height:100vh;
  background:
    radial-gradient(circle at 50% -10%,rgba(20,120,255,.2),transparent 32%),
    radial-gradient(circle at 10% 50%,rgba(0,80,255,.07),transparent 30%),
    var(--bg);
  color:var(--text);
  font-family:Inter,sans-serif;
  overflow-x:hidden;
}

/* PARTICULES */

.particles{
  position:fixed;
  inset:0;
  pointer-events:none;
  overflow:hidden;
  z-index:0;
}

.particle{
  position:absolute;
  width:2px;
  height:2px;
  border-radius:50%;
  background:#70cfff;
  box-shadow:0 0 12px #248cff;
  animation:float linear infinite;
}

@keyframes float{
  from{
    transform:translateY(110vh);
    opacity:0;
  }
  15%{
    opacity:.7;
  }
  85%{
    opacity:.7;
  }
  to{
    transform:translateY(-10vh);
    opacity:0;
  }
}

/* HEADER */

header{
  position:relative;
  z-index:1;
  text-align:center;
  padding:105px 20px 90px;
  border-bottom:1px solid var(--border);
  overflow:hidden;
}

.glow{
  position:absolute;
  width:800px;
  height:550px;
  left:50%;
  top:-360px;
  transform:translateX(-50%);
  background:radial-gradient(
    circle,
    rgba(25,135,255,.4),
    transparent 68%
  );
  filter:blur(20px);
  animation:pulse 5s ease-in-out infinite;
}

@keyframes pulse{
  0%,100%{
    opacity:.55;
    transform:translateX(-50%) scale(1);
  }
  50%{
    opacity:1;
    transform:translateX(-50%) scale(1.15);
  }
}

.eyebrow{
  position:relative;
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:10px 18px;
  border:1px solid rgba(70,160,255,.3);
  border-radius:999px;
  color:var(--cyan);
  font-size:11px;
  font-weight:700;
  letter-spacing:.2em;
  text-transform:uppercase;
  animation:fadeDown .8s ease both;
}

.eyebrow::before{
  content:"";
  width:7px;
  height:7px;
  border-radius:50%;
  background:#36aaff;
  box-shadow:
    0 0 8px #36aaff,
    0 0 18px #36aaff;
  animation:blink 2s infinite;
}

@keyframes blink{
  0%,100%{opacity:1}
  50%{opacity:.35}
}

.brand{
  position:relative;
  margin-top:22px;
  font-family:"Space Grotesk",sans-serif;
  font-size:clamp(48px,10vw,92px);
  font-weight:700;
  letter-spacing:.04em;
  background:
    linear-gradient(
      90deg,
      #fff,
      #8bddff,
      #268cff,
      #fff
    );
  background-size:300%;
  -webkit-background-clip:text;
  color:transparent;
  animation:
    fadeUp .8s .1s ease both,
    shine 5s linear infinite;
}

@keyframes shine{
  to{
    background-position:-300% center;
  }
}

.tagline{
  position:relative;
  max-width:520px;
  margin:18px auto 0;
  color:var(--muted);
  font-size:15px;
  line-height:1.7;
  animation:fadeUp .8s .2s ease both;
}

@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(25px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

@keyframes fadeDown{
  from{
    opacity:0;
    transform:translateY(-20px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

/* MAIN */

.container{
  position:relative;
  z-index:1;
  width:min(900px,calc(100% - 36px));
  margin:auto;
  padding:80px 0 110px;
}

.section{
  display:flex;
  align-items:center;
  gap:18px;
  margin-bottom:32px;
  color:#9ba7b8;
  font-size:11px;
  font-weight:700;
  letter-spacing:.2em;
  text-transform:uppercase;
}

.section::after{
