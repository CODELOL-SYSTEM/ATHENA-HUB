  height:1px;
  flex:1;
  background:linear-gradient(
    90deg,
    rgba(100,170,255,.25),
    transparent
  );
}

/* PRODUITS */

.products{
  display:flex;
  flex-direction:column;
  gap:25px;
}

/* GROSSE CARTE */

.produit{
  position:relative;
  min-height:310px;
  padding:45px;
  border:1px solid var(--border);
  border-radius:24px;
  overflow:hidden;

  background:
    linear-gradient(
      145deg,
      rgba(19,28,42,.95),
      rgba(5,9,16,.98)
    );

  box-shadow:
    0 20px 70px rgba(0,0,0,.3);

  opacity:0;
  animation:cardIn .8s ease forwards;

  transition:
    transform .35s ease,
    border-color .35s ease,
    box-shadow .35s ease;
}

.produit:nth-child(1){
  animation-delay:.15s;
}

.produit:nth-child(2){
  animation-delay:.3s;
}

.produit:nth-child(3){
  animation-delay:.45s;
}

@keyframes cardIn{
  from{
    opacity:0;
    transform:translateY(45px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

.produit::before{
  content:"";
  position:absolute;
  width:400px;
  height:400px;
  right:-200px;
  top:-250px;
  background:radial-gradient(
    circle,
    rgba(30,140,255,.25),
    transparent 68%
  );
  pointer-events:none;
}

.produit::after{
  content:"";
  position:absolute;
  left:0;
  top:0;
  width:100%;
  height:1px;
  background:linear-gradient(
    90deg,
    transparent,
    rgba(80,180,255,.8),
    transparent
  );
  opacity:.5;
}

.produit:hover{
  transform:translateY(-8px);
  border-color:rgba(50,150,255,.5);
  box-shadow:
    0 30px 90px rgba(0,0,0,.55),
    0 0 45px rgba(30,130,255,.12);
}

/* NUMERO */

.numero{
  position:absolute;
  top:25px;
  right:30px;
  color:rgba(125,211,252,.25);
  font-family:"Space Grotesk",sans-serif;
  font-size:13px;
  font-weight:700;
  letter-spacing:.15em;
}

/* ICONE */

.icon{
  position:relative;
  width:65px;
  height:65px;
  margin-bottom:28px;
  border:1px solid rgba(70,170,255,.4);
  border-radius:16px;
  background:rgba(30,130,255,.07);
  box-shadow:
    inset 0 0 25px rgba(30,130,255,.08),
    0 0 25px rgba(30,130,255,.08);
  display:flex;
  align-items:center;
  justify-content:center;
}

.icon::before{
  content:"";
  width:25px;
  height:25px;
  border:2px solid #50baff;
  transform:rotate(45deg);
  box-shadow:
    0 0 15px rgba(50,180,255,.7);
  animation:iconFloat 3s ease-in-out infinite;
}

@keyframes iconFloat{
  0%,100%{
    transform:rotate(45deg) translateY(0);
  }
  50%{
    transform:rotate(45deg) translateY(-4px);
  }
}

/* TEXTE */

.produit h2{
  position:relative;
  font-family:"Space Grotesk",sans-serif;
  font-size:28px;
  margin-bottom:10px;
}

.desc{
  position:relative;
  max-width:600px;
  color:var(--muted);
  font-size:14px;
  line-height:1.7;
  margin-bottom:28px;
}

.bottom{
  position:relative;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:25px;
  flex-wrap:wrap;
}

.prix{
  font-family:"Space Grotesk",sans-serif;
  font-size:38px;
  font-weight:700;
}

.prix span{
  color:var(--muted);
  font-size:13px;
  font-weight:500;
}

/* BOUTONS */

.actions{
  display:flex;
  gap:10px;
}

.btn{
  position:relative;
  border:0;
  border-radius:11px;
  padding:15px 24px;
  min-width:190px;
  font-size:13px;
  font-weight:700;
  text-decoration:none;
  cursor:pointer;
  display:flex;
  justify-content:center;
  align-items:center;
  overflow:hidden;
  transition:.25s ease;
}

.btn::after{
  content:"";
  position:absolute;
  left:-120%;
  top:0;
  width:70%;
  height:100%;
  background:linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,.4),
    transparent
  );
  transform:skewX(-20deg);
  transition:.65s;
}

.btn:hover::after{
  left:140%;
}

.btn-paypal{
  background:#ffc439;
  color:#003087;
  box-shadow:
    0 8px 30px rgba(255,196,57,.15);
}

.btn-paypal:hover{
  transform:translateY(-3px);
  box-shadow:
    0 12px 40px rgba(255,196,57,.35);
}

.btn-virement{
  background:#1769e8;
  color:white;
  box-shadow:
    0 8px 30px rgba(23,105,232,.18);
}

.btn-virement:hover{
  transform:translateY(-3px);
  box-shadow:
    0 12px 40px rgba(23,105,232,.4);
}

/* VIREMENT */

.infos-virement{
  max-height:0;
  opacity:0;
  overflow:hidden;
  margin-top:0;
  padding:0 22px;
  border:1px solid transparent;
  border-radius:14px;
  background:rgba(30,120,230,.04);
  transition:.5s ease;
}

.infos-virement.open{
  max-height:300px;
  opacity:1;
  margin-top:25px;
  padding:22px;
  border-color:rgba(50,150,255,.2);
}

.infos-virement strong{
  display:block;
  margin-bottom:13px;
  color:var(--cyan);
  font-size:11px;
  letter-spacing:.16em;
  text-transform:uppercase;
}

.ligne{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding:11px 0;
  border-bottom:1px dashed rgba(255,255,255,.08);
  color:#c8d0dc;
  font-size:13px;
}

.ligne:last-child{
  border-bottom:0;
}

/* FOOTER */

footer{
  position:relative;
  z-index:1;
  border-top:1px solid var(--border);
  text-align:center;
  padding:35px 20px;
  color:#667184;
  font-size:11px;
  letter-spacing:.12em;
}

/* MOBILE */

@media(max-width:650px){

  header{
    padding:75px 18px 65px;
  }

  .container{
    width:min(100% - 24px,900px);
    padding:55px 0 80px;
  }

  .produit{
    padding:32px 24px;
    min-height:0;
  }

  .bottom{
    align-items:stretch;
    flex-direction:column;
  }

  .prix{
    font-size:34px;
  }

  .actions{
    width:100%;
    flex-direction:column;
  }

  .btn{
    width:100%;
    min-width:0;
  }

  .ligne{
    flex-direction:column;
    gap:4px;
  }

  .numero{
    top:20px;
    right:20px;
  }
}

@media(prefers-reduced-motion:reduce){

  *,
  *::before,
  *::after{
    animation-duration:.01ms !important;
    animation-iteration-count:1 !important;
    transition:none !important;
  }
}
</style>
</head>

